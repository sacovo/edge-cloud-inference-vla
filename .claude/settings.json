{
  "enabledPlugins": {
    "academic-research-skills@academic-research-skills": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/bib_check.sh",
            "timeout": 180,
            "statusMessage": "Verifying bibliography against arXiv..."
          }
        ]
      }
    ]
  }
}
